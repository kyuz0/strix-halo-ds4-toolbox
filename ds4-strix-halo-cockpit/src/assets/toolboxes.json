{
  "registry": "docker.io/kyuz0/strix-halo-ds4-toolbox",
  "groups": [
    {
      "name": "Official Toolboxes",
      "toolboxes": [
        {
          "name": "ds4-rocm-10.0",
          "tag": "rocm-10.0",
          "description": "ROCm 10.0 MMQ kernel lab — Recommended for most users",
          "engine_args": [
            "--device",
            "/dev/dri",
            "--device",
            "/dev/kfd",
            "--group-add",
            "video",
            "--group-add",
            "render",
            "--group-add",
            "sudo",
            "--security-opt",
            "seccomp=unconfined"
          ],
          "server_binary": "ds4-server"
        },
        {
          "name": "ds4-gfx1201-rocm-7.14",
          "tag": "gfx1201-rocm-7.14",
